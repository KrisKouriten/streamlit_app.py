# Copy to .env.local for local dev, or set these in Vercel project settings.

# Postgres connection string from Neon / Supabase / Vercel Postgres.
DATABASE_URL=postgres://user:password@host:5432/dbname

# A long random string for signing login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Public base URL of the deployed app, used to build invite / password-reset
# links in emails. Optional — on Vercel the request origin is used if unset.
#   e.g. https://finance.kouriten.com
APP_BASE_URL=

# Resend email — sends account invites and password-reset links from a verified
# sender on your own domain. Both are required to enable email; if either is
# missing the app still creates users and shows the admin a one-time link to
# share manually. Setup: create a Resend account, verify your sending domain
# (DNS records), create an API key.
RESEND_API_KEY=
RESEND_SENDER=Miniso UK Finance OS <no-reply@your-domain>
